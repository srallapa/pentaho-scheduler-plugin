<module rename-to="schedulerplugin">

  <inherits name='com.google.gwt.user.User'/>
  <inherits name='com.google.gwt.xml.XML'/>
  <inherits name='com.google.gwt.i18n.I18N'/>
  <inherits name='com.google.gwt.gen2.Gen2'/>
  <inherits name='com.google.gwt.gen2.table.ScrollTable'/>
  <inherits name='com.google.gwt.gen2.table.FixedWidthTable'/>
  <inherits name='org.pentaho.gwt.widgets.Widgets'/>

  <inherits name='com.googlecode.gwtx.Java'/>
  <inherits name="com.google.gwt.logging.Logging"/>

  <set-property name="gwt.logging.enabled" value="TRUE"/>            # To disable logging
  <set-property name="gwt.logging.consoleHandler" value="ENABLED"/>
  <set-property name="gwt.logging.logLevel" value="INFO"/>
  <set-property name="gwt.logging.simpleRemoteHandler" value="ENABLED"/>

  <entry-point class='org.pentaho.mantle.client.dialogs.scheduling.NewScheduleDialogEntryPoint'/>

  <source path=""/>
</module>
